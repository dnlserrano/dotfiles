# A few everyday aliases. Everything else stays in the muscle-memory layer.

# Git
alias g='git'
alias gs='git status --short'
alias gd='git diff'
alias gl='git log --oneline --decorate -10'

# Navigation
alias ..='cd ..'
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
